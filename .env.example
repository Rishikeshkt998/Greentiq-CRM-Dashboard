# ==========================================
# PUBLIC CLIENT ENVIRONMENT VARIABLES
# ==========================================
NEXT_PUBLIC_APP_NAME="Greentiq Innovations CRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10

# ==========================================
# FEATURE FLAGS (SWITCHABLE)
# ==========================================
# Set to true to enable JWT Auth & Login modal. Default false for reviewer zero-friction
ENABLE_AUTH=false
ENABLE_MOCK_DELAY=true

# ==========================================
# SERVER SECRETS (NEVER EXPOSED TO BROWSER)
# ==========================================
JWT_ACCESS_SECRET="greentiq_access_token_secret_2026_super_key"
JWT_REFRESH_SECRET="greentiq_refresh_token_secret_2026_super_key"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MOCK_API_SIMULATED_LATENCY_MS=400

# ==========================================
# DATABASE CONFIGURATION (SWITCHABLE)
# Optional: If empty, falls back seamlessly to in-memory seed database
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/crm_db"
MONGODB_URI=""
